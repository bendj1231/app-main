{
  "mcpServers": {
    "cloudflare-api": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.cloudflare.com/mcp"]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@cyanheads/git-mcp-server"]
    },
    "wikipedia-mcp": {
      "command": "npx",
      "args": ["-y", "wikipedia-mcp"]
    },
    "wiki-mcp": {
      "command": "npx",
      "args": ["-y", "wiki-mcp"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "google-ai-mode": {
      "command": "npx",
      "args": ["-y", "google-ai-mode-mcp@latest"],
      "env": {
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      }
    },
    "regulatory-monitor": {
      "command": "npx",
      "args": ["-y", "tsx", "/Users/bowler/Documents/apps/app-main/mcp/regulatory-monitor/src/index.ts"]
    },
    "wikimedia-image-search": {
      "command": "npx",
      "args": ["-y", "wikimedia-image-search-mcp"]
    },
    "auth0": {
      "command": "npx",
      "args": ["-y", "@auth0/auth0-mcp-server", "run"],
      "env": {
        "DEBUG": "auth0-mcp"
      }
    }
  }
}
