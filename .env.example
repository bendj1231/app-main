# Analytics Configuration
# Copy this file to .env.local and fill in your actual values

# Groq AI — server-side only, set in Supabase Edge Function secrets
# Get key from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_DEBUG=false

# Sentry Error Tracking
VITE_SENTRY_DSN=https://xxxxxxxxxxxxx@o1234.ingest.sentry.io/1234567
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0

# Environment
VITE_ENVIRONMENT=development
VITE_APP_VERSION=1.0.0

# Web Vitals
VITE_WEB_VITALS_ENABLED=true

# Auth0 Configuration
VITE_AUTH0_DOMAIN=dev-ir828tguibp1dh5f.eu.auth0.com
VITE_AUTH0_CLIENT_ID=FSW7zJxyBNJRvZGxN2xGH2bAQxwzHVmb
VITE_AUTH0_AUDIENCE=https://dev-ir828tguibp1dh5f.eu.auth0.com/api/v2/
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/callback

# MFA Encryption (32+ char random string for pgcrypto)
MFA_ENCRYPTION_KEY=your_random_32_char_mfa_key_here

# Existing environment variables
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Redirect URI
# Production: https://pilotrecognition.com/callback
# Development: http://localhost:5173/callback
VITE_GOOGLE_REDIRECT_URI=https://pilotrecognition.com/callback

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_RESTRICTED_KEY=rk_test_your_restricted_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
VITE_STRIPE_RECOGNITION_PLUS_ANNUAL_PRICE_ID=price_your_recognition_plus_annual_price_id
VITE_STRIPE_RECOGNITION_PLUS_SEMI_ANNUAL_PRICE_ID=price_your_recognition_plus_semi_annual_price_id
STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id
STRIPE_SEMI_ANNUAL_PRICE_ID=price_your_semi_annual_price_id

# App URL for Stripe redirects
VITE_APP_URL=http://localhost:5173

# walt.id Credential Infrastructure
# Issuer URL — use demo for dev, self-hosted for production
VITE_WALT_ISSUER_URL=https://issuer.demo.walt.id
VITE_WALT_ISSUER_DID=did:web:pilotrecognition.com
# Persistent issuer private key JWK — store in Supabase secrets as WALT_ISSUER_JWK
# Generated: P-256 EC key. Public key is in pilotterminal/.well-known/did.json
# NEVER commit the private key. Add to Supabase Dashboard > Settings > Secrets:
# Key name: WALT_ISSUER_JWK
# Value: {"key_ops":["sign"],"ext":true,"kty":"EC","x":"63PRX8nbvysXLnMDY912FmEHn2ecgcUF76vvj_cA8GA","y":"Id1saME5YPZtyhcJ1uMlLgboBt-SmldTgBiabV20oQY","crv":"P-256","d":"<PRIVATE_D_VALUE>"}
WALT_ISSUER_JWK=set_in_supabase_secrets_not_here

# Pilot Vault Encryption
# Store ONLY in Supabase Dashboard > Settings > Edge Functions > Secrets
# Value: generate with: node -e "require('crypto').randomBytes(48).toString('base64')|console.log()"
# WARNING: Changing this key invalidates ALL pilot vaults. Never rotate without a migration plan.

# Admin Configuration
VITE_ADMIN_EMAIL=admin@example.com

# External URLs
VITE_LOGO_URL=https://res.cloudinary.com/dridtecu6/image/upload/v1776997648/general/efqjszksldcdm6kbnzoq.png
VITE_ACCREDITATION_URL=https://lh3.googleusercontent.com/d/12pf5A8zfaAmnN0TFPrL6_OV8Em7lX_p9
VITE_ACCREDITATION_2_URL=https://lh3.googleusercontent.com/d/1EbPJSQbhBiEnBtP6lSPrYIkLxANUDJBl
VITE_ACCREDITATION_3_URL=https://lh3.googleusercontent.com/d/1kpzjxNltR6BrX8IEitGbathVAZe8HVF-
VITE_ACCREDITATION_4_URL=https://lh3.googleusercontent.com/d/1mO2UeKmfgb2Z3ZMqcEeBze5w119HZgUb
VITE_ACCREDITATION_5_URL=https://lh3.googleusercontent.com/d/1sbabopQiNZkWXsGcePTH1MjzY2HzJate
VITE_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSejj0W4rddiU2Ijs0NQEnvdBZdT45fCxzcp8JR15PTOiLC-OA/viewform?usp=sf_link
VITE_AVIATION_WEATHER_LINK=https://aviationweather.gov/metar

# Cloudinary Configuration
# 
# Single Cloudinary account for all image uploads:
# - PROFILE: User profile photos (folder: profiles)
# - CONTENT: Pathway images, airline logos, platform images (folder: content)
# 
# Set in Supabase Dashboard → Settings → Edge Functions → Secrets
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 Configuration (Encrypted Profile Image Storage)
# Set these in Supabase Dashboard > Settings > Edge Functions > Secrets
# These are used by the profile-image-encrypted edge function
CLOUDFLARE_R2_ACCOUNT_ID=your_r2_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=pilotrecognition-profile-images

# Resend Webhook Configuration
# RESEND_WEBHOOK_SECRET — used to verify webhook signatures (HMAC-SHA256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# Resend Email Routing (JSON mapping of inbound addresses → forward destinations)
# Example: {"contact@pilotrecognition.com":"team@example.com"}
RESEND_EMAIL_ROUTING={}

# Enterprise Access Notifications
# Comma-separated list of emails to receive enterprise access requests
ENTERPRISE_NOTIFICATION_EMAILS=admin@pilotrecognition.com,operations@pilotrecognition.com

# Veremark Webhook Secret
# Used to verify incoming Veremark webhook signatures
VEREMARK_WEBHOOK_SECRET=your_veremark_webhook_secret

# Cloudflare Worker API Endpoints
# Used for data operations (replaces Supabase)
VITE_PILOT_API_URL=https://pilotrecognition-api.benjamintigerbowler.workers.dev
VITE_PLATFORM_API_URL=https://platform-api.benjamintigerbowler.workers.dev
