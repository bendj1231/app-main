{
  "rewrites": [
    {
      "has": [{ "type": "host", "value": "enterprise.pilotrecognition.com" }],
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/framework/full",
      "destination": "/framework/full/index.html"
    },
    {
      "source": "/((?!api|assets|docs|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "has": [{ "type": "host", "value": "enterprise.pilotrecognition.com" }],
      "source": "/",
      "destination": "/enterprise-access",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
