    },
    {
      "source": "/((?!api|assets|docs|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "has": [{ "type": "host", "value": "wallet.pilotrecognition.com" }],
      "source": "/",
      "destination": "/platform?tab=wallet",
      "permanent": false
    },
    {
      "has": [{ "type": "host", "value": "platform.pilotrecognition.com" }],
      "source": "/",
      "destination": "/platform",
      "permanent": false
    },
    {
      "has": [{ "type": "host", "value": "enterprise.pilotrecognition.com" }],
      "source": "/",
      "destination": "/enterprise-access",
      "permanent": false
    },
    {
      "has": [{ "type": "host", "value": "enterprise.pilotrecognition.com" }],
      "source": "/framework/full",
      "destination": "/framework/full/index.html",
      "permanent": false
    },
    {
      "has": [{ "type": "host", "value": "pathways.pilotrecognition.com" }],
      "source": "/",
      "destination": "/discover-pathways",
      "permanent": false
    },
    {
      "has": [{ "type": "host", "value": "recognitionplus.pilotrecognition.com" }],
